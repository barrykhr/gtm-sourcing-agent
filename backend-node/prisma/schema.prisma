// Talyn — Node.js backend Prisma schema.
//
// This is hand-verified field-by-field against
// src/gtm_sourcing_agent/models_orm.py (the Python SQLAlchemy models) —
// not blindly generated by `prisma db pull` — so every column name, type,
// default, and constraint here is a deliberate match, not an assumption.
//
// Points at the SAME database the Python backend uses. No new database,
// no data migration: every existing user/job/candidate is visible the
// moment this client connects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  email        String   @unique
  role         String   @default("recruiter")
  passwordHash String   @map("password_hash")
  passwordSalt String   @map("password_salt")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions      Session[]
  resetTokens   PasswordResetToken[]

  @@map("users")
}

model Session {
  token     String   @id
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model PasswordResetToken {
  token     String   @id
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model Job {
  roleId          String    @id @map("role_id")
  title           String?
  roleFamily      String?   @map("role_family")
  clientName      String?   @map("client_name")
  shareToken      String?   @unique @map("share_token")
  lifecycleStatus String    @default("OPEN") @map("lifecycle_status")
  ownerEmail      String?   @map("owner_email")
  roleValue       Float?    @map("role_value")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  recruiters   JobRecruiter[]
  sections     JobSection[]
  candidates   CanonicalCandidate[]
  evaluations  CandidateEvaluation[]
  tasks        Task[]
  activity     ActivityLog[]
  communications CommunicationLogEntry[]

  @@map("jobs")
}

model JobRecruiter {
  id         Int      @id @default(autoincrement())
  roleId     String   @map("role_id")
  email      String
  assignment String   @default("contributor")
  addedAt    DateTime @default(now()) @map("added_at")

  job Job @relation(fields: [roleId], references: [roleId])

  @@unique([roleId, email], map: "uq_job_recruiter")
  @@map("job_recruiters")
}

model JobSection {
  id         Int      @id @default(autoincrement())
  roleId     String   @map("role_id")
  sectionKey String   @map("section_key")
  data       Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  job Job @relation(fields: [roleId], references: [roleId])

  @@unique([roleId, sectionKey], map: "uq_job_section")
  @@map("job_sections")
}

model CanonicalCandidate {
  id              String   @id
  name            String
  currentCompany  String   @default("") @map("current_company")
  currentTitle    String   @default("") @map("current_title")
  location        String   @default("")
  sourceUrl       String   @default("") @map("source_url")
  firstSeenJobId  String   @map("first_seen_job_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  firstSeenJob Job                   @relation(fields: [firstSeenJobId], references: [roleId])
  evaluations  CandidateEvaluation[]

  @@map("candidates")
}

model Task {
  id         String    @id
  roleId     String    @map("role_id")
  kind       String
  status     String    @default("pending")
  args       Json      @default("{}")
  result     Json?
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  finishedAt DateTime? @map("finished_at")

  job Job @relation(fields: [roleId], references: [roleId])

  @@map("tasks")
}

model CandidateEvaluation {
  id                             Int       @id @default(autoincrement())
  roleId                         String    @map("role_id")
  candidateEvaluationId          String    @map("candidate_evaluation_id")
  canonicalCandidateId           String    @map("canonical_candidate_id")
  data                           Json
  prioritization                 Json?
  note                           String    @default("")
  phone                          String    @default("")
  email                          String    @default("")
  resumeFileKey                  String?   @map("resume_file_key")
  resumeFilename                 String?   @map("resume_filename")
  conversationSummary            String    @default("") @map("conversation_summary")
  conversationSummaryUpdatedAt   DateTime? @map("conversation_summary_updated_at")
  conversationSummaryEntryCount  Int       @default(0) @map("conversation_summary_entry_count")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")

  job       Job                @relation(fields: [roleId], references: [roleId])
  candidate CanonicalCandidate @relation(fields: [canonicalCandidateId], references: [id])

  @@unique([roleId, candidateEvaluationId], map: "uq_role_candidate_eval")
  @@map("candidate_evaluations")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  roleId      String   @map("role_id")
  userEmail   String   @map("user_email")
  action      String
  detail      String   @default("")
  candidateId String?  @map("candidate_id")
  createdAt   DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [roleId], references: [roleId])

  @@map("activity_log")
}

model CommunicationLogEntry {
  id                     Int      @id @default(autoincrement())
  roleId                 String   @map("role_id")
  candidateEvaluationId  String   @map("candidate_evaluation_id")
  channel                String
  direction              String   @default("outbound")
  content                String   @default("")
  transcript             String?
  contactUsed            String   @default("") @map("contact_used")
  loggedBy               String   @default("") @map("logged_by")
  followupStage          Int      @default(0) @map("followup_stage")
  createdAt              DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [roleId], references: [roleId])

  @@map("communication_log_entries")
}

model WorkspaceSettings {
  id                 String   @id @default("default")
  followupTemplate   String   @map("followup_template")
  autoSendFollowups  Boolean  @default(false) @map("auto_send_followups")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("workspace_settings")
}
