{
  "name": "talyn-backend-node",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js/TypeScript port of the Talyn FastAPI backend. Source of truth for behavior is src/gtm_sourcing_agent/ (Python) — see docs/migration.md. Kept alongside the Python backend until validated; not yet the deployed backend.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@prisma/client": "^5.20.0",
    "csv-parse": "^5.5.6",
    "eta": "^3.5.0",
    "fastify": "^5.0.0",
    "google-auth-library": "^9.14.1",
    "mammoth": "^1.8.0",
    "nodemailer": "^6.9.15",
    "pdf-parse": "^1.1.1",
    "pino": "^9.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.16",
    "@types/pdf-parse": "^1.1.4",
    "mailparser": "^3.7.1",
    "prisma": "^5.20.0",
    "smtp-server": "^3.13.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
