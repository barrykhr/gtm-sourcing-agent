# Talyn frontend — environment variables
#
# Copy to `.env.local` for local development, or set in the Vercel
# project's Environment Variables settings for a real deployment.

# The backend API's base URL. Defaults to http://localhost:8000 (the
# local dev server) when unset — a real deployment must set this to the
# deployed backend's URL (e.g. Render), or every request from the
# frontend will fail.
NEXT_PUBLIC_API_URL=http://localhost:8000
