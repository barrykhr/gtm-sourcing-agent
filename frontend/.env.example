# Talyn frontend — environment variables
#
# Copy to `.env.local` for local development, or set in the Vercel
# project's Environment Variables settings for a real deployment.

# The backend API's real URL. Read server-side only, by next.config.ts's
# rewrite (never shipped to the browser as a NEXT_PUBLIC_ var) — every
# frontend API call goes to this same origin's /api/* instead, which
# Vercel proxies to this URL. That keeps the session cookie first-party
# even though the backend lives on a different domain (Render); see
# next.config.ts's comment for why that matters. Defaults to
# http://localhost:8000 (the local dev backend) when unset — a real
# deployment must set this to the deployed backend's URL.
BACKEND_URL=http://localhost:8000
