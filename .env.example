# Talyn — environment variables
#
# Copy this file to `.env` for local development (python-dotenv loads it
# automatically). In production (Render, or any host), set these as real
# environment variables in the platform's dashboard — never commit a
# populated `.env` file.
#
# Every variable below is read by the backend (src/gtm_sourcing_agent/)
# unless marked "frontend". Nothing here is required to run the app in
# demo mode with the mock LLM server (scripts/mock_llm_server.py) — these
# only matter for a real deployment.


# ── Required for real AI features ───────────────────────────────────────

# Real Anthropic API key. Without this, every LLM-touching route (JD
# intake, ICP, talent map, candidate analysis, Copilot, etc.) fails with
# a clear "check ANTHROPIC_API_KEY" error — this app never falls back to
# fabricated output. Read directly by the anthropic SDK (llm_client.py's
# anthropic.Anthropic() picks it up automatically); there is no
# GTM_-prefixed equivalent.
ANTHROPIC_API_KEY=


# ── Database (db.py) ─────────────────────────────────────────────────────

# Postgres connection string. Omit this to use a local SQLite file
# instead (data/gtm_sourcing_agent.db) — fine for local development, but
# SQLite has no persistence guarantee across a container restart/redeploy
# on most hosts, so a real deployment holding real candidate data needs
# this set. Render hands out `postgres://...`; the app rewrites that to
# `postgresql://...` itself, so either scheme works here.
# Migrations (Alembic) run automatically on startup — no separate
# release-command step required.
DATABASE_URL=


# ── Auth / cookies / CORS (api.py, auth.py) ─────────────────────────────

# Set to "true" in production (HTTPS) so the session cookie gets the
# Secure flag. Leave unset/"false" for local http://localhost development.
GTM_COOKIE_SECURE=false

# Cookie SameSite policy. "lax" works when frontend and backend share a
# site; a cross-site deployment (e.g. Vercel frontend + Render backend on
# different domains) needs "none" — and GTM_COOKIE_SECURE=true is
# required whenever SameSite=None (browsers reject None cookies without
# Secure).
GTM_COOKIE_SAMESITE=lax

# Comma-separated list of origins allowed to call this API with
# credentials (CORS). Must include your deployed frontend's exact origin
# (scheme + host + port), e.g.:
#   GTM_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
GTM_CORS_ORIGINS=http://localhost:3000

# Optional invite-code gate on signup. If set, /auth/signup requires this
# exact code in the request body; if unset, signup is open to anyone with
# the URL. Recommended once real candidate data is involved.
GTM_SIGNUP_CODE=

# Google Sign-In (auth.py). Both optional — omit to disable "Sign in with
# Google" entirely; the email/password flow keeps working either way.
GTM_GOOGLE_CLIENT_ID=
# Restrict Google sign-in to one Workspace domain, e.g. "kibitron.com".
# Leave unset to allow any Google account.
GTM_GOOGLE_ALLOWED_DOMAIN=


# ── Logging (api.py) ─────────────────────────────────────────────────────

# Python logging level for the whole app. INFO (the default) shows task
# worker activity, migration runs, and orphan-task recovery; DEBUG is
# noisier (SQL-adjacent detail); WARNING is quieter.
LOG_LEVEL=INFO


# ── Resume file storage (file_storage.py, Batch 4) ──────────────────────
#
# Optional. Without these set, resume uploads still work exactly as
# before — text is extracted and the candidate is created — the original
# PDF/DOCX/TXT file just isn't retained anywhere. Set all four
# (RESUME_STORAGE_REGION is the only one with a usable default) to
# persist the original file to any S3-compatible object store.
# Cloudflare R2 is the recommended provider (no egress fees, S3-API
# compatible) — its endpoint looks like:
#   https://<account-id>.r2.cloudflarestorage.com
# Plain AWS S3 works too: leave RESUME_STORAGE_ENDPOINT_URL unset and set
# RESUME_STORAGE_REGION to your bucket's real AWS region.
RESUME_STORAGE_ENDPOINT_URL=
RESUME_STORAGE_BUCKET=
RESUME_STORAGE_ACCESS_KEY_ID=
RESUME_STORAGE_SECRET_ACCESS_KEY=
RESUME_STORAGE_REGION=auto


# ── Integration credentials (not yet connected — see /integrations/status) ──
#
# These three are read only to report whether an environment *could*
# connect each integration (GET /integrations/status's
# "environment_configured" field) — no OAuth callback flow exists yet for
# any of them, so setting these does NOT make Google Workspace, Calendly,
# or telephony actually connect. Setting them is honest prep, not a
# working integration; leave unset until the callback flow is built.
GOOGLE_OAUTH_CLIENT_ID=
CALENDLY_CLIENT_ID=
TELEPHONY_PROVIDER_API_KEY=


# ── Deployment platform variables (not read by the app directly) ────────

# Render (or any host) sets this itself and expects the start command to
# bind to it, e.g.: uvicorn gtm_sourcing_agent.api:app --host 0.0.0.0 --port $PORT
# Not something you set by hand — documented here so the start command
# makes sense.
# PORT=


# ── Frontend (frontend/.env.local — Vercel project settings) ────────────
#
# The variable below belongs in the FRONTEND deployment (Vercel), not
# here — Next.js only reads NEXT_PUBLIC_* vars from its own project's
# environment, never from the backend's.
#
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
